# Team configuration, committed on purpose: this public repository is ready to run after "git clone".
# All documents in this project are fictional. Template with every option: .env.example

# Login for the web app
APP_USERNAME=hackathon
APP_PASSWORD=GetWellOCR

# Mistral on Azure AI Foundry (EU region, Sweden Central)
#   Mistral Large 3: AI extraction, AI history text, and OCR (reads the page image)
MISTRAL_API_KEY=CKkdd84QHyrrFNnANKkkBuc8di9H4Rd3y9YqDLfGorG2YtxzsksVJQQJ99CKACfhMk5XJ3w3AAAAACOGFjPE
MISTRAL_CHAT_ENDPOINT=https://ais-health-inno-hack-008-swedencentral.services.ai.azure.com/openai/v1/chat/completions
MISTRAL_CHAT_MODEL=Mistral-Large-3
# Mistral Document AI: not deployed on this resource, so OCR uses Mistral Large 3. Set these only
# if a Document AI deployment is added: .../providers/mistral/azure/ocr
MISTRAL_OCR_ENDPOINT=
MISTRAL_OCR_MODEL=mistral-document-ai-2512

# Defaults (both can be switched in the app sidebar)
OCR_ENGINE=tesseract          # tesseract | mistral
EXTRACTOR=rules               # rules | llm (Mistral Large 3)

# Pages read in parallel
OCR_WORKERS=2

# Only needed if Python cannot find Tesseract on its own (ignored if the path does not exist)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
