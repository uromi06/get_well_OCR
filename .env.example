# Template with every option. The committed .env already contains working team keys,
# so after cloning nothing needs to be copied. Use this file to run with your own keys.

# Azure Document Intelligence (create the resource in an EU region,
# e.g. Germany West Central or West Europe)
AZURE_DI_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_DI_KEY=<paste-key-1-here>

# Mistral on Azure AI Foundry (EU region, Sweden Central). Optional:
# leave these empty to use Tesseract only. Fictional or anonymised documents only.
#   OCR:  Mistral Large 3 reads the page image via MISTRAL_CHAT_ENDPOINT + MISTRAL_API_KEY.
#         Only if a Document AI deployment exists: set MISTRAL_OCR_ENDPOINT
#         (https://<resource>.services.ai.azure.com/providers/mistral/azure/ocr)
#   Chat: Mistral Large 3 (writes the patient history from the doctor-confirmed facts)
MISTRAL_API_KEY=
MISTRAL_OCR_ENDPOINT=
MISTRAL_OCR_MODEL=mistral-document-ai-2512
# Only needed if the OCR deployment uses a different key than MISTRAL_API_KEY
MISTRAL_OCR_KEY=
MISTRAL_CHAT_ENDPOINT=
MISTRAL_CHAT_MODEL=Mistral-Large-3

# Which OCR engine the app uses by default: tesseract | mistral | azure
OCR_ENGINE=tesseract

# Page extraction: rules | llm (Mistral Large 3, falls back to rules if Mistral fails)
EXTRACTOR=rules

# Only needed if Python cannot find Tesseract on its own
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Login for the web app (required; the app refuses to start without both)
APP_USERNAME=<choose-a-username>
APP_PASSWORD=<choose-a-password>
